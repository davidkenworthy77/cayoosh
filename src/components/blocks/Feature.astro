---
import { sanitizeHref } from "emdash";
import ImageCard from "../ImageCard.astro";
import Paragraphs from "../Paragraphs.astro";

const { value } = Astro.props;
---

<section class="section container--medium hpb hpb--last">
	<ImageCard image={value.image} title={value.title} titleTag="h3" portrait>
		<Paragraphs text={value.body} />
		{
			value.button_label && value.button_url && (
				<a href={sanitizeHref(value.button_url)} class="button button--medium">
					{value.button_label}
				</a>
			)
		}
	</ImageCard>
</section>
