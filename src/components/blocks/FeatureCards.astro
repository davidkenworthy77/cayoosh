---
import ImageCard from "../ImageCard.astro";
import Paragraphs from "../Paragraphs.astro";

const { value } = Astro.props;
const cards = value.cards ?? [];
---

<section class="section container--medium hpb">
	{
		cards.map((card: any, i: number) => (
			<>
				{i > 0 && <hr class={`rule ${i % 2 === 1 ? "rule--half-left" : "rule--half-right"}`} />}
				<ImageCard image={card.image} title={card.title} reverse={i % 2 === 1}>
					<Paragraphs text={card.body} />
				</ImageCard>
			</>
		))
	}
</section>
