---
import type { MediaValue } from "emdash";
import { sanitizeHref } from "emdash";
import Img from "./Img.astro";

interface Props {
	tagline?: string | null;
	details?: {
		acknowledgement?: string | null;
		footer_logo?: MediaValue | null;
		location?: string | null;
		phone?: string | null;
		instagram_url?: string | null;
		linkedin_url?: string | null;
		copyright?: string | null;
	};
}
const { tagline, details } = Astro.props;
---

<footer class="footer section--dark">
	<div class="footer-inner">
		{
			details?.acknowledgement && (
				<p class="small">
					<em>{details.acknowledgement}</em>
				</p>
			)
		}
		{tagline && <h4>{tagline}</h4>}
		<Img image={details?.footer_logo} sizes="150px" class="footer-logo" />
		{
			(details?.location || details?.phone) && (
				<p>
					{details.location}
					{details.location && details.phone && <br />}
					{details.phone}
				</p>
			)
		}
		{
			(details?.instagram_url || details?.linkedin_url) && (
				<nav class="footer-social" aria-label="Social">
					{details.instagram_url && (
						<a href={sanitizeHref(details.instagram_url)} target="_blank" rel="noopener" aria-label="Instagram">
							<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
								<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2" />
								<circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" />
								<circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" />
							</svg>
						</a>
					)}
					{details.linkedin_url && (
						<a href={sanitizeHref(details.linkedin_url)} target="_blank" rel="noopener" aria-label="LinkedIn">
							<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
								<circle cx="5" cy="5" r="2.3" fill="currentColor" />
								<rect x="3" y="9" width="4" height="12" fill="currentColor" />
								<path
									fill="currentColor"
									d="M10 9h3.8v1.7c.6-1.1 2-2 4-2 3.2 0 4.2 2 4.2 5.2V21h-4v-6.2c0-1.500-.5-2.500-1.900-2.500-1.500 0-2.100 1-2.100 2.500V21h-4z"
								/>
							</svg>
						</a>
					)}
				</nav>
			)
		}
		{details?.copyright && <p class="small">{details.copyright}</p>}
	</div>
</footer>
